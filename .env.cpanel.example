APP_NAME="atozinterpreting"
APP_ENV=production
APP_KEY=base64:GENERATE_A_NEW_KEY
APP_DEBUG=false
APP_URL=https://your-domain.example.com

LOG_CHANNEL=daily

# Audit web requests in production (optional)
AUDIT_REQUESTS=false

# === Database ===
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# === Cache/Session/Queue ===
BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# === Redis (optional) ===
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# === Mail ===
# Start with log driver to avoid external calls until SMTP/Mailgun is configured
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=portal@your-domain.example.com
MAIL_FROM_NAME="ATOZINTERPRETING"

# Example SMTP (uncomment and fill to enable SMTP)
# MAIL_DRIVER=smtp
# MAIL_HOST=smtp.mailgun.org
# MAIL_PORT=587
# MAIL_USERNAME=postmaster@mg.your-domain.example.com
# MAIL_PASSWORD=your_smtp_password
# MAIL_ENCRYPTION=tls

# === Sentry (optional) ===
SENTRY_LARAVEL_DSN=

# === AWS S3 (optional) ===
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-2
AWS_BUCKET=
AWS_URL=

# === Email routing (optional) ===
TO_EMAIL=bookings@your-domain.example.com

# ==== SMS Configuration ====
SMS_ENABLED=false
SMS_DRIVER=twilio
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=